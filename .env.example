# Copy to .env.local for development. Never commit real values.
# See README.md "Environment" for what each variable does.

# SITE_URL=https://www.calixeden.com
# NOINDEX=true

# Development: enquiries are logged (without personal data), not delivered.
MAIL_TRANSPORT=log

# Production delivery (required on the live site)
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ENQUIRY_TO=
# ENQUIRY_FROM=
# FORM_SECRET=

# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# SHOW_CONTENT_PLACEHOLDERS=true
# Review previews only: include the olive story in a production build.
# Requires NOINDEX=true, otherwise the build stops. Set to false to hide it in `next dev`.
# STORY_PREVIEW=true
