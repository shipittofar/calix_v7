{
  "name": "calix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "STORY_PREVIEW=true NOINDEX=true next build",
    "start": "next start",
    "start:preview": "STORY_PREVIEW=true NOINDEX=true next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:story": "node scripts/check-story.mjs config && node scripts/check-story.mjs sources",
    "validate": "npm run lint && npm run typecheck && npm run check:story",
    "verify:builds": "npm run build && node scripts/check-story.mjs output .next off && npm run build:preview && node scripts/check-story.mjs output .next-preview on"
  },
  "dependencies": {
    "next": "16.4.0",
    "nodemailer": "10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
